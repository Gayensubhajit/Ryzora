{
  "id": "lockscreen-qylock-field",
  "name": "Field",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Authentic Qylock lockscreen theme 'Field', featuring lightweight declarative QML rendering, smooth animations, and high performance Wayland lock and SDDM greeter support.",
  "tags": [
    "qylock",
    "quickshell",
    "sddm",
    "field",
    "image"
  ],
  "color_palette": [
    "#8b5cf6",
    "#12141a",
    "#24283b",
    "#a9b1d6"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/Main.qml",
      "target": "~/.local/share/ryzora/lockscreens/qylock/field/Main.qml",
      "description": "field files/Main.qml"
    },
    {
      "source": "files/bg.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/field/bg.png",
      "description": "field files/bg.png"
    },
    {
      "source": "files/font/Orbitron-VariableFont_wght.ttf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/field/font/Orbitron-VariableFont_wght.ttf",
      "description": "field files/font/Orbitron-VariableFont_wght.ttf"
    },
    {
      "source": "files/metadata.desktop",
      "target": "~/.local/share/ryzora/lockscreens/qylock/field/metadata.desktop",
      "description": "field files/metadata.desktop"
    },
    {
      "source": "files/theme.conf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/field/theme.conf",
      "description": "field files/theme.conf"
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/field/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "~/.local/share/ryzora/lockscreens/qylock/field/Main.qml",
          "description": "field Main.qml (quickshell)"
        },
        {
          "source": "files/bg.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/field/bg.png",
          "description": "field bg.png (quickshell)"
        },
        {
          "source": "files/font/Orbitron-VariableFont_wght.ttf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/field/font/Orbitron-VariableFont_wght.ttf",
          "description": "field font/Orbitron-VariableFont_wght.ttf (quickshell)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "~/.local/share/ryzora/lockscreens/qylock/field/metadata.desktop",
          "description": "field metadata.desktop (quickshell)"
        },
        {
          "source": "files/theme.conf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/field/theme.conf",
          "description": "field theme.conf (quickshell)"
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-field/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "/usr/share/sddm/themes/ryzora-field/Main.qml",
          "description": "field Main.qml (sddm)"
        },
        {
          "source": "files/bg.png",
          "target": "/usr/share/sddm/themes/ryzora-field/bg.png",
          "description": "field bg.png (sddm)"
        },
        {
          "source": "files/font/Orbitron-VariableFont_wght.ttf",
          "target": "/usr/share/sddm/themes/ryzora-field/font/Orbitron-VariableFont_wght.ttf",
          "description": "field font/Orbitron-VariableFont_wght.ttf (sddm)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "/usr/share/sddm/themes/ryzora-field/metadata.desktop",
          "description": "field metadata.desktop (sddm)"
        },
        {
          "source": "files/theme.conf",
          "target": "/usr/share/sddm/themes/ryzora-field/theme.conf",
          "description": "field theme.conf (sddm)"
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/field"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "22b92ae3318930c9e5b088b3c516b96d0fde6b15",
    "license": "GPL-3.0",
    "path": "themes/field"
  },
  "media": {
    "poster": "assets/lockscreens/field-poster.jpg",
    "preview_animated": "assets/lockscreens/field.gif",
    "media_type": "image"
  },
  "media_type": "image",
  "config_schema": {
    "options": {
      "themeMode": {
        "id": "themeMode",
        "label": "Theme Mode",
        "type": "select",
        "default": "dark",
        "options": [
          {
            "value": "light",
            "label": "Light Mode"
          },
          {
            "value": "dark",
            "label": "Dark Mode"
          }
        ]
      }
    }
  }
}
