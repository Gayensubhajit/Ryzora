{
  "id": "lockscreen-qylock-material-you",
  "name": "Material You",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Dynamic wallpaper-adaptive pastel palette, rounded pill elements, large clock typography, and fluid status pills.",
  "tags": [
    "material-you",
    "minimal",
    "modern",
    "quickshell",
    "qylock",
    "sddm"
  ],
  "color_palette": [
    "#a8c7fa",
    "#10131c",
    "#1f2430",
    "#d3e3fd"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/config",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/theme.conf",
      "description": "Material You configuration file."
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/material-you/theme.conf",
      "files": [
        {
          "source": "files/config",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/theme.conf",
          "description": "Material You Quickshell session lock configuration."
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-material-you/Main.qml",
      "files": [
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-material-you/Main.qml",
          "description": "Material You SDDM greeter QML entrypoint."
        },
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-material-you/metadata.desktop",
          "description": "Material You SDDM metadata."
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/material-you"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "license": "GPL-3.0",
    "path": "themes/material-you"
  },
  "media": {
    "poster": "assets/lockscreens/material-you-poster.jpg",
    "preview_video": "assets/lockscreens/material-you-preview.mp4",
    "preview_animated": "assets/lockscreens/material-you.gif"
  }
}