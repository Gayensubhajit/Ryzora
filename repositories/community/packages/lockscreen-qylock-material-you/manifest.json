{
  "id": "lockscreen-qylock-material-you",
  "name": "Material You",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Authentic Qylock lockscreen theme 'Material You', featuring lightweight declarative QML rendering, smooth animations, and high performance Wayland lock and SDDM greeter support.",
  "tags": [
    "qylock",
    "quickshell",
    "sddm",
    "material-you",
    "animated"
  ],
  "color_palette": [
    "#8b5cf6",
    "#12141a",
    "#24283b",
    "#a9b1d6"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/Main.qml",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/Main.qml",
      "description": "material-you files/Main.qml"
    },
    {
      "source": "files/bg.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/bg.png",
      "description": "material-you files/bg.png"
    },
    {
      "source": "files/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
      "description": "material-you files/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf"
    },
    {
      "source": "files/metadata.desktop",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/metadata.desktop",
      "description": "material-you files/metadata.desktop"
    },
    {
      "source": "files/theme.conf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/theme.conf",
      "description": "material-you files/theme.conf"
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/material-you/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/Main.qml",
          "description": "material-you Main.qml (quickshell)"
        },
        {
          "source": "files/bg.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/bg.png",
          "description": "material-you bg.png (quickshell)"
        },
        {
          "source": "files/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
          "description": "material-you font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf (quickshell)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/metadata.desktop",
          "description": "material-you metadata.desktop (quickshell)"
        },
        {
          "source": "files/theme.conf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/material-you/theme.conf",
          "description": "material-you theme.conf (quickshell)"
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-material-you/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "/usr/share/sddm/themes/ryzora-material-you/Main.qml",
          "description": "material-you Main.qml (sddm)"
        },
        {
          "source": "files/bg.png",
          "target": "/usr/share/sddm/themes/ryzora-material-you/bg.png",
          "description": "material-you bg.png (sddm)"
        },
        {
          "source": "files/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
          "target": "/usr/share/sddm/themes/ryzora-material-you/font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf",
          "description": "material-you font/GoogleSans-VariableFont_GRAD,opsz,wght.ttf (sddm)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "/usr/share/sddm/themes/ryzora-material-you/metadata.desktop",
          "description": "material-you metadata.desktop (sddm)"
        },
        {
          "source": "files/theme.conf",
          "target": "/usr/share/sddm/themes/ryzora-material-you/theme.conf",
          "description": "material-you theme.conf (sddm)"
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
