{
  "id": "lockscreen-qylock-winter",
  "name": "Winter Snowfall",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Cozy silent winter snowfall with frosty pine silhouettes and ambient digital clock.",
  "tags": [
    "ambient",
    "cozy",
    "quickshell",
    "qylock",
    "sddm",
    "snow",
    "winter"
  ],
  "color_palette": [
    "#38bdf8",
    "#0f172a",
    "#93c5fd",
    "#f8fafc"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/config",
      "target": "~/.local/share/ryzora/lockscreens/qylock/winter/theme.conf",
      "description": "Winter Snowfall configuration file."
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/winter/theme.conf",
      "files": [
        {
          "source": "files/config",
          "target": "~/.local/share/ryzora/lockscreens/qylock/winter/theme.conf",
          "description": "Winter Snowfall Quickshell session lock configuration."
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-winter/Main.qml",
      "files": [
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-winter/Main.qml",
          "description": "Winter Snowfall SDDM greeter QML entrypoint."
        },
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-winter/metadata.desktop",
          "description": "Winter Snowfall SDDM theme metadata."
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/winter"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "license": "GPL-3.0",
    "path": "themes/winter"
  },
  "media": {
    "poster": "assets/lockscreens/winter-poster.jpg",
    "preview_video": "assets/lockscreens/winter-preview.mp4",
    "preview_animated": "assets/lockscreens/winter.gif"
  }
}