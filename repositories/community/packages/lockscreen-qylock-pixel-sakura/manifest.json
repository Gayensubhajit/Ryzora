{
  "id": "lockscreen-qylock-pixel-sakura",
  "name": "Pixel Sakura Blossom",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Gentle cherry blossom petals drifting over a quiet twilight village shrine.",
  "tags": [
    "cherry-blossom",
    "japan",
    "pixel",
    "quickshell",
    "qylock",
    "sakura",
    "sddm"
  ],
  "color_palette": [
    "#f472b6",
    "#1e1024",
    "#fb7185",
    "#fff1f2"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/config",
      "target": "~/.local/share/ryzora/lockscreens/qylock/pixel-sakura/theme.conf",
      "description": "Pixel Sakura Blossom configuration file."
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/pixel-sakura/theme.conf",
      "files": [
        {
          "source": "files/config",
          "target": "~/.local/share/ryzora/lockscreens/qylock/pixel-sakura/theme.conf",
          "description": "Pixel Sakura Blossom Quickshell session lock configuration."
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-pixel-sakura/Main.qml",
      "files": [
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-pixel-sakura/Main.qml",
          "description": "Pixel Sakura Blossom SDDM greeter QML entrypoint."
        },
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-pixel-sakura/metadata.desktop",
          "description": "Pixel Sakura Blossom SDDM theme metadata."
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/pixel-sakura"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "license": "GPL-3.0",
    "path": "themes/pixel-sakura"
  },
  "media": {
    "poster": "assets/lockscreens/pixel-sakura-poster.jpg",
    "preview_video": "assets/lockscreens/pixel-sakura-preview.mp4",
    "preview_animated": "assets/lockscreens/pixel-sakura.gif"
  }
}