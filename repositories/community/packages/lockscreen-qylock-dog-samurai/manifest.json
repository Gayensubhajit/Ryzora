{
  "id": "lockscreen-qylock-dog-samurai",
  "name": "Dog Samurai",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "A cinematic video lock: a straw-hatted samurai dog with a sheathed katana as crimson petals fall, paired with a bold digital clock and minimal login field.",
  "tags": [
    "samurai",
    "cinematic",
    "video",
    "animated",
    "qylock",
    "quickshell",
    "sddm"
  ],
  "color_palette": [
    "#945a46",
    "#141612",
    "#24283b",
    "#a9b1d6"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/config",
      "target": "~/.local/share/ryzora/lockscreens/qylock/dog-samurai/theme.conf",
      "description": "Dog Samurai configuration file."
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/dog-samurai/theme.conf",
      "files": [
        {
          "source": "files/config",
          "target": "~/.local/share/ryzora/lockscreens/qylock/dog-samurai/theme.conf",
          "description": "Dog Samurai Quickshell session lock configuration."
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-dog-samurai/Main.qml",
      "files": [
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-dog-samurai/Main.qml",
          "description": "Dog Samurai SDDM greeter QML entrypoint."
        },
        {
          "source": "files/config",
          "target": "/usr/share/sddm/themes/ryzora-dog-samurai/metadata.desktop",
          "description": "Dog Samurai SDDM metadata."
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/dog-samurai"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "license": "GPL-3.0",
    "path": "themes/dog-samurai"
  },
  "media": {
    "poster": "assets/lockscreens/dog-samurai-poster.jpg",
    "preview_video": "assets/lockscreens/dog-samurai-preview.mp4",
    "preview_animated": "assets/lockscreens/dog-samurai.gif"
  }
}
