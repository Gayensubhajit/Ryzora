{
  "id": "lockscreen-qylock-minecraft",
  "name": "Minecraft Panoramas",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Slowly revolving classic Minecraft landscape with voxel skies and blocky typography.",
  "tags": [
    "classic",
    "gaming",
    "minecraft",
    "quickshell",
    "qylock",
    "sddm",
    "voxel"
  ],
  "color_palette": [
    "#65a30d",
    "#1c1917",
    "#eab308",
    "#f5f5f4"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/Main.qml",
      "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/Main.qml",
      "description": "minecraft Main.qml"
    },
    {
      "source": "files/background.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/background.png",
      "description": "minecraft background.png"
    },
    {
      "source": "files/metadata.desktop",
      "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/metadata.desktop",
      "description": "minecraft metadata.desktop"
    },
    {
      "source": "files/theme.conf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/theme.conf",
      "description": "minecraft theme.conf"
    },
    {
      "source": "files/title.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/title.png",
      "description": "minecraft title.png"
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/minecraft/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/Main.qml",
          "description": "minecraft Main.qml (quickshell)"
        },
        {
          "source": "files/background.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/background.png",
          "description": "minecraft background.png (quickshell)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/metadata.desktop",
          "description": "minecraft metadata.desktop (quickshell)"
        },
        {
          "source": "files/theme.conf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/theme.conf",
          "description": "minecraft theme.conf (quickshell)"
        },
        {
          "source": "files/title.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/minecraft/title.png",
          "description": "minecraft title.png (quickshell)"
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-minecraft/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "/usr/share/sddm/themes/ryzora-minecraft/Main.qml",
          "description": "minecraft Main.qml (sddm)"
        },
        {
          "source": "files/background.png",
          "target": "/usr/share/sddm/themes/ryzora-minecraft/background.png",
          "description": "minecraft background.png (sddm)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "/usr/share/sddm/themes/ryzora-minecraft/metadata.desktop",
          "description": "minecraft metadata.desktop (sddm)"
        },
        {
          "source": "files/theme.conf",
          "target": "/usr/share/sddm/themes/ryzora-minecraft/theme.conf",
          "description": "minecraft theme.conf (sddm)"
        },
        {
          "source": "files/title.png",
          "target": "/usr/share/sddm/themes/ryzora-minecraft/title.png",
          "description": "minecraft title.png (sddm)"
        }
      ]
    }
  },
  "source": {
    "type": "git",
    "repository": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "path": "themes/minecraft"
  },
  "provenance": {
    "upstream": "https://github.com/Darkkal44/qylock",
    "revision": "main",
    "license": "GPL-3.0",
    "path": "themes/minecraft"
  },
  "media": {
    "poster": "assets/lockscreens/minecraft-poster.jpg",
    "media_type": "image"
  },
  "media_type": "image"
}