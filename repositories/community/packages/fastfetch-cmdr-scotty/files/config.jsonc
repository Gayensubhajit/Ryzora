{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": 
  {
  "type": "auto",
  "source": "~/.config/fastfetch/presets/fastfetch-cmdr-scotty/images/Tsukikko.png",
  "width": 64
  },
  "modules": [
	"break",
{
            "type": "custom",
            "format": "\u001b[33m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "title",
            "key": " PC",
            "keyColor": "red",
            "format": "{user-name}"
        },
	{
	    "type": "host",
		"key": "│ ├",
		"hostname": true,
		"keyColor": "red"
	},
        {
            "type": "cpu",
            "key": "│ ├",
            "showPeCoreCount": true,
            "keyColor": "red"
        },
        {
            "type": "gpu",
            "key": "│ ├󰢮",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "│ ├",
            "keyColor": "red"
        },
        {
            "type": "disk",
            "key": "│ ├",
            "keyColor": "red",
	    "format": "{1} / {2} ({3}) - {9}"
	},
	{
	    "type": "swap",
	    "key": "│ └",
	    "keyColor": "red",
	},
        {
            "type": "custom",
            "format": "\u001b[33m├──────────────────────Software──────────────────────┤"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "green"
        },
	{
	    "type": "terminal",
            "key": "│ ├",
            "keyColor": "green"
        },
	{
            "type": "shell",
            "key": "│ └",
            "keyColor": "green"
        },
        {
            "type": "de",
            "key": " DE",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "blue"
        },
	{
	    "type": "font",
	    "key": "│ ├",
	    "keyColor": "blue"
	},
	{
	    "type": "cursor",
	    "key": "│ └󰆿",
	    "keyColor": "blue"
	},
        {
            "type": "custom",
            "format": "\u001b[33m├────────────────────Miscellaneous───────────────────┤"
        },
        {
            "type": "uptime",
            "key": "│  Uptime",
            "keyColor": "magenta"
        },
	{
	    "type": "localip",
	    "key": "│  IP",
	    "showIpv4": true,
	    "keyColor": "magenta"
	},
	{ 
	    "type": "media",
	    "key": "│  Music",
	    "keyColor": "magenta",
	    "format": "{1} - {4}"
	},
	{
	    "type": "datetime",
	    "key": "│  Date and Time",
	    "keyColor": "magenta",
	    "format": "{3}/{11}/{1} - {14}:{18} {22}"
	},
        {
            "type": "custom",
            "format": "\u001b[33m└────────────────────────────────────────────────────┘"
        },
        {"type": "colors",
        "paddingLeft": 20,
        "symbol": "star"
        },
        "break"
  ]
}
