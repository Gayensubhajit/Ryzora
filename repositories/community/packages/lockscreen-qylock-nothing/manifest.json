{
  "id": "lockscreen-qylock-nothing",
  "name": "Nothing",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Authentic Qylock lockscreen theme 'Nothing', featuring lightweight declarative QML rendering, smooth animations, and high performance Wayland lock and SDDM greeter support.",
  "tags": [
    "qylock",
    "quickshell",
    "sddm",
    "nothing",
    "image"
  ],
  "color_palette": [
    "#8b5cf6",
    "#12141a",
    "#24283b",
    "#a9b1d6"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/Main.qml",
      "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/Main.qml",
      "description": "nothing files/Main.qml"
    },
    {
      "source": "files/font/NDot55.otf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/font/NDot55.otf",
      "description": "nothing files/font/NDot55.otf"
    },
    {
      "source": "files/font/NType82.otf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/font/NType82.otf",
      "description": "nothing files/font/NType82.otf"
    },
    {
      "source": "files/metadata.desktop",
      "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/metadata.desktop",
      "description": "nothing files/metadata.desktop"
    },
    {
      "source": "files/theme.conf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/theme.conf",
      "description": "nothing files/theme.conf"
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/nothing/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/Main.qml",
          "description": "nothing Main.qml (quickshell)"
        },
        {
          "source": "files/font/NDot55.otf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/font/NDot55.otf",
          "description": "nothing font/NDot55.otf (quickshell)"
        },
        {
          "source": "files/font/NType82.otf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/font/NType82.otf",
          "description": "nothing font/NType82.otf (quickshell)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/metadata.desktop",
          "description": "nothing metadata.desktop (quickshell)"
        },
        {
          "source": "files/theme.conf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/nothing/theme.conf",
          "description": "nothing theme.conf (quickshell)"
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-nothing/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "/usr/share/sddm/themes/ryzora-nothing/Main.qml",
          "description": "nothing Main.qml (sddm)"
        },
        {
          "source": "files/font/NDot55.otf",
          "target": "/usr/share/sddm/themes/ryzora-nothing/font/NDot55.otf",
          "description": "nothing font/NDot55.otf (sddm)"
        },
        {
          "source": "files/font/NType82.otf",
          "target": "/usr/share/sddm/themes/ryzora-nothing/font/NType82.otf",
          "description": "nothing font/NType82.otf (sddm)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "/usr/share/sddm/themes/ryzora-nothing/metadata.desktop",
          "description": "nothing metadata.desktop (sddm)"
        },
        {
          "source": "files/theme.conf",
          "target": "/usr/share/sddm/themes/ryzora-nothing/theme.conf",
          "description": "nothing theme.conf (sddm)"
        }
      ]
    }
  },
