{
  "id": "lockscreen-qylock-windows-7",
  "name": "Windows 7",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "Darkkal44",
  "package_type": "lockscreen",
  "description": "Authentic Qylock lockscreen theme 'Windows 7', featuring lightweight declarative QML rendering, smooth animations, and high performance Wayland lock and SDDM greeter support.",
  "tags": [
    "qylock",
    "quickshell",
    "sddm",
    "windows-7",
    "image"
  ],
  "color_palette": [
    "#8b5cf6",
    "#12141a",
    "#24283b",
    "#a9b1d6"
  ],
  "compatibility": {
    "desktops": [
      "hyprland",
      "sway",
      "cosmic"
    ],
    "sessions": [
      "wayland"
    ],
    "distros": [],
    "required": [],
    "optional": [
      "sddm"
    ]
  },
  "files": [
    {
      "source": "files/Main.qml",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/Main.qml",
      "description": "windows-7 files/Main.qml"
    },
    {
      "source": "files/background.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/background.png",
      "description": "windows-7 files/background.png"
    },
    {
      "source": "files/font/.gitkeep",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/font/.gitkeep",
      "description": "windows-7 files/font/.gitkeep"
    },
    {
      "source": "files/metadata.desktop",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/metadata.desktop",
      "description": "windows-7 files/metadata.desktop"
    },
    {
      "source": "files/pfp.png",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/pfp.png",
      "description": "windows-7 files/pfp.png"
    },
    {
      "source": "files/theme.conf",
      "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/theme.conf",
      "description": "windows-7 files/theme.conf"
    }
  ],
  "provider": "qylock",
  "targets": {
    "quickshell": {
      "supported": true,
      "dependencies": [
        "quickshell"
      ],
      "scope": "user",
      "entrypoint": "~/.local/share/ryzora/lockscreens/qylock/windows-7/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/Main.qml",
          "description": "windows-7 Main.qml (quickshell)"
        },
        {
          "source": "files/background.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/background.png",
          "description": "windows-7 background.png (quickshell)"
        },
        {
          "source": "files/font/.gitkeep",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/font/.gitkeep",
          "description": "windows-7 font/.gitkeep (quickshell)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/metadata.desktop",
          "description": "windows-7 metadata.desktop (quickshell)"
        },
        {
          "source": "files/pfp.png",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/pfp.png",
          "description": "windows-7 pfp.png (quickshell)"
        },
        {
          "source": "files/theme.conf",
          "target": "~/.local/share/ryzora/lockscreens/qylock/windows-7/theme.conf",
          "description": "windows-7 theme.conf (quickshell)"
        }
      ]
    },
    "sddm": {
      "supported": true,
      "dependencies": [
        "sddm"
      ],
      "scope": "system",
      "entrypoint": "/usr/share/sddm/themes/ryzora-windows-7/Main.qml",
      "files": [
        {
          "source": "files/Main.qml",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/Main.qml",
          "description": "windows-7 Main.qml (sddm)"
        },
        {
          "source": "files/background.png",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/background.png",
          "description": "windows-7 background.png (sddm)"
        },
        {
          "source": "files/font/.gitkeep",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/font/.gitkeep",
          "description": "windows-7 font/.gitkeep (sddm)"
        },
        {
          "source": "files/metadata.desktop",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/metadata.desktop",
          "description": "windows-7 metadata.desktop (sddm)"
        },
        {
          "source": "files/pfp.png",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/pfp.png",
          "description": "windows-7 pfp.png (sddm)"
        },
        {
          "source": "files/theme.conf",
          "target": "/usr/share/sddm/themes/ryzora-windows-7/theme.conf",
          "description": "windows-7 theme.conf (sddm)"
        }
      ]
    }
  },
