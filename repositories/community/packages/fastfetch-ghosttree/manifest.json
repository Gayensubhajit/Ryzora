{
  "id": "fastfetch-ghosttree",
  "name": "Ghosttree Catfetch",
  "version": "1.0.0",
  "ryzora_spec": "1",
  "author": "ghosttree",
  "package_type": "fastfetch",
  "description": "Cozy terminal readout with custom cat emblem and color-accented system modules.",
  "tags": [
    "Fastfetch",
    "Cat",
    "Cozy",
    "Animal",
    "Emblem"
  ],
  "color_palette": [
    "#f9e2af",
    "#fab387",
    "#89b4fa",
    "#1e1e2e"
  ],
  "compatibility": {
    "desktops": [],
    "sessions": [],
    "distros": [],
    "required": [
      "fastfetch"
    ],
    "optional": []
  },
  "files": [
    {
      "source": "files/config.jsonc",
      "target": "~/.config/fastfetch/presets/fastfetch-ghosttree/config.jsonc",
      "description": "Fastfetch asset config.jsonc"
    },
    {
      "source": "files/images/cat.png",
      "target": "~/.config/fastfetch/presets/fastfetch-ghosttree/images/cat.png",
      "description": "Fastfetch asset images/cat.png"
    },
    {
      "source": "files/readme.md",
      "target": "~/.config/fastfetch/presets/fastfetch-ghosttree/readme.md",
      "description": "Fastfetch asset readme.md"
    }
  ]
}