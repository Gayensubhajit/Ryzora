#!/usr/bin/env bash
# =============================================================================
# ryzora-sddm-helper — Ryzora Restricted Privileged SDDM Helper
# =============================================================================
# Invoked via pkexec, authorized by Polkit io.ryzora.sddm.policy
# Exposes ONLY these named operations with strict path validation:
#
#   install_theme   <staging_dir> <theme_slug>
#   remove_theme    <theme_slug>
#   activate_theme  <theme_slug>
#   restore_theme   <previous_theme_name>
#   deactivate_theme
#
# Security invariants:
#  - Destination paths are constructed internally, never from raw user input
#  - Theme slugs validated against [a-zA-Z0-9_-]{1,64}
#  - Source must be under /tmp/ryzora-staging-*/
#  - Destinations always /usr/share/sddm/themes/ryzora-<slug>/ or /etc/sddm.conf.d/
#  - No shell evaluation of package content
#  - No chmod +x on copied files
#  - No symlink following in source (cp --no-dereference)
# =============================================================================

set -euo pipefail

SYS_ROOT="${RYZORA_SYSTEM_ROOT:-}"
SDDM_THEMES_DIR="${SYS_ROOT}/usr/share/sddm/themes"
SDDM_CONF_DIR="${SYS_ROOT}/etc/sddm.conf.d"
RYZORA_CONF_FILE="${SDDM_CONF_DIR}/zz-ryzora-theme.conf"
LEGACY_CONF_FILE="${SDDM_CONF_DIR}/ryzora-theme.conf"

die() {
    echo "ryzora-sddm-helper: ERROR: $*" >&2
    exit 1
}

log() {
    echo "ryzora-sddm-helper: $*" >&2
}

validate_slug() {
    local slug="$1"
    if [[ ! "$slug" =~ ^[a-zA-Z0-9_-]{1,64}$ ]]; then
        die "Invalid theme slug '${slug}': must match [a-zA-Z0-9_-]{1,64}"
    fi
}

validate_staging_dir() {
    local dir="$1"
    # Must be under /tmp/ryzora-staging-*/
    if [[ ! "$dir" =~ ^/tmp/ryzora-staging-[a-zA-Z0-9_-]+(/[a-zA-Z0-9_./-]+)?$ ]]; then
        die "Invalid staging directory '${dir}': must be under /tmp/ryzora-staging-*/"
    fi
    if [ ! -d "$dir" ]; then
        die "Staging directory '${dir}' does not exist"
    fi
    # Reject symlinks pointing outside /tmp
    while IFS= read -r -d '' symlink; do
        target=$(readlink -f "$symlink" 2>/dev/null || true)
        if [[ -n "$target" && ! "$target" =~ ^/tmp/ ]]; then
            die "Staging directory contains symlink outside /tmp: $symlink -> $target"
        fi
    done < <(find "$dir" -type l -print0)
}

op_install_theme() {
    local staging_dir="$1"
    local slug="$2"

    validate_slug "$slug"
    validate_staging_dir "$staging_dir"

    local dest="${SDDM_THEMES_DIR}/ryzora-${slug}"

    if [ -e "$dest" ]; then
        die "Theme destination '${dest}' already exists. Run remove_theme first."
    fi

    mkdir -p "${SDDM_THEMES_DIR}"
    cp -r --no-dereference "$staging_dir" "$dest"

    # Remove exec bits, ensure readable
    find "$dest" -type f -exec chmod a-x,a+r {} +
    find "$dest" -type d -exec chmod 755 {} +

    # Verify mandatory files
    if [ ! -f "${dest}/Main.qml" ]; then
        rm -rf "$dest"
        die "Theme missing required Main.qml. Installation rolled back."
    fi
    if [ ! -f "${dest}/metadata.desktop" ] && [ ! -f "${dest}/theme.conf" ]; then
        rm -rf "$dest"
        die "Theme missing metadata (theme.conf or metadata.desktop). Installation rolled back."
    fi

    log "Installed theme: ${dest}"
    echo "OK:installed:${dest}"
}

op_remove_theme() {
    local slug="$1"
    validate_slug "$slug"
    local dest="${SDDM_THEMES_DIR}/ryzora-${slug}"
    if [ ! -d "$dest" ]; then
        log "Theme '${dest}' does not exist, nothing to remove."
        echo "OK:not_found:${dest}"
        return 0
    fi
    rm -rf "$dest"
    log "Removed theme: ${dest}"
    echo "OK:removed:${dest}"
}

op_activate_theme() {
    local slug="$1"
    validate_slug "$slug"
    local theme_dir="${SDDM_THEMES_DIR}/ryzora-${slug}"
    if [ ! -d "$theme_dir" ]; then
        die "Theme '${theme_dir}' is not installed. Install it first."
    fi
    mkdir -p "${SDDM_CONF_DIR}"
    # Remove un-prefixed legacy conf file if present
    rm -f "${LEGACY_CONF_FILE}"

    # Write zz-ryzora-theme.conf for explicit lexicographical precedence
    printf '[Theme]\nCurrent=ryzora-%s\n' "${slug}" > "${RYZORA_CONF_FILE}"
    chmod 644 "${RYZORA_CONF_FILE}"
    local written
    written=$(cat "${RYZORA_CONF_FILE}")
    if [[ "$written" != *"Current=ryzora-${slug}"* ]]; then
        rm -f "${RYZORA_CONF_FILE}"
        die "Config verification failed after writing '${RYZORA_CONF_FILE}'"
    fi
    log "Activated theme: ryzora-${slug}"
    echo "OK:activated:ryzora-${slug}"
}

op_restore_theme() {
    local theme_name="$1"
    # Always remove Ryzora-owned drop-in configurations
    rm -f "${RYZORA_CONF_FILE}" "${LEGACY_CONF_FILE}"

    if [ -z "$theme_name" ] || [ "$theme_name" = "default" ] || [ "$theme_name" = "none" ]; then
        log "Deactivated Ryzora SDDM theme, restored system defaults."
        echo "OK:restored:default"
        return 0
    fi

    validate_slug "$theme_name"

    # If the theme is already set by another file in /etc/sddm.conf.d/, do not write redundant drop-in
    if grep -RqsE "^[[:space:]]*Current[[:space:]]*=[[:space:]]*${theme_name}[[:space:]]*$" "${SDDM_CONF_DIR}"/*.conf 2>/dev/null; then
        log "Theme '${theme_name}' is already provided by underlying configuration."
        echo "OK:restored:${theme_name}"
        return 0
    fi

    mkdir -p "${SDDM_CONF_DIR}"
    printf '[Theme]\nCurrent=%s\n' "${theme_name}" > "${RYZORA_CONF_FILE}"
    chmod 644 "${RYZORA_CONF_FILE}"
    local written
    written=$(cat "${RYZORA_CONF_FILE}")
    if [[ "$written" != *"Current=${theme_name}"* ]]; then
        die "Config verification failed after restoring '${RYZORA_CONF_FILE}'"
    fi
    log "Restored theme: ${theme_name}"
    echo "OK:restored:${theme_name}"
}


op_set_theme_background() {
    local staging_dir="$1"
    local slug="$2"

    validate_slug "$slug"
    validate_staging_dir "$staging_dir"

    local dest="${SDDM_THEMES_DIR}/ryzora-${slug}"
    if [ ! -d "$dest" ]; then
        die "Theme destination '${dest}' does not exist. Install the theme first."
    fi

    # Ownership and health verification of existing theme engine
    if [ ! -f "${dest}/Main.qml" ]; then
        die "Engine destination '${dest}' is missing Main.qml."
    fi
    if [ ! -d "${dest}/components" ]; then
        die "Engine destination '${dest}' is missing components/."
    fi

    # Snapshot Main.qml hash before any operations to verify immutability
    local main_qml_sha_before
    main_qml_sha_before=$(sha256sum "${dest}/Main.qml" | awk '{print $1}')

    # Strict staging directory allowlist validation
    while IFS= read -r -d '' item; do
        if [ -L "$item" ]; then
            die "Symlink detected in staging: $item"
        fi
        local rel="${item#"${staging_dir}"}"
        rel="${rel#/}"
        if [ -z "$rel" ]; then
            continue
        fi

        if [ -f "$item" ]; then
            case "$rel" in
                backgrounds/*)
                    local bg_name="${rel#backgrounds/}"
                    if [[ "$bg_name" =~ / ]] || [[ ! "$bg_name" =~ ^[a-zA-Z0-9_.-]{1,128}$ ]]; then
                        die "Invalid or disallowed background filename in staging: ${bg_name}"
                    fi
                    ;;
                configs/ryzora-active.conf|metadata.desktop|theme.conf)
                    ;;
                *)
                    die "Forbidden file in staging (not allowlisted): ${rel}"
                    ;;
            esac
        elif [ -d "$item" ]; then
            case "$rel" in
                backgrounds|configs)
                    ;;
                *)
                    die "Forbidden subdirectory in staging: ${rel}"
                    ;;
            esac
        fi
    done < <(find "$staging_dir" -print0)

    # Staging must contain at least one allowlisted mutation
    local has_mutations=false

    # Materialize allowlisted background files: 1. Reuse existing -> 2. Hardlink -> 3. Btrfs CoW reflink -> 4. Copy fallback
    if [ -d "${staging_dir}/backgrounds" ]; then
        mkdir -p "${dest}/backgrounds"
        for bg in "${staging_dir}/backgrounds"/*; do
            if [ -f "$bg" ]; then
                local bname
                bname=$(basename "$bg")
                local target="${dest}/backgrounds/${bname}"
                # 1. Reuse existing if already present and byte-for-byte identical
                if [ -f "$target" ]; then
                    local sz1 sz2
                    sz1=$(stat -c%s "$bg" 2>/dev/null || echo 1)
                    sz2=$(stat -c%s "$target" 2>/dev/null || echo 2)
                    if [ "$sz1" = "$sz2" ] && cmp -s "$bg" "$target" 2>/dev/null; then
                        has_mutations=true
                        continue
                    fi
                fi
                # 2. Hard link -> 3. CoW clone (reflink) -> 4. Standard copy
                ln "$bg" "$target" 2>/dev/null ||                 cp --reflink=always --no-dereference "$bg" "$target" 2>/dev/null ||                 cp --reflink=auto --no-dereference "$bg" "$target" 2>/dev/null ||                 cp --no-dereference "$bg" "$target"
                chmod 644 "$target"
                has_mutations=true
            fi
        done
    fi

    # Copy configs/ryzora-active.conf if present
    if [ -f "${staging_dir}/configs/ryzora-active.conf" ]; then
        mkdir -p "${dest}/configs"
        cp --no-dereference "${staging_dir}/configs/ryzora-active.conf" "${dest}/configs/ryzora-active.conf"
        chmod 644 "${dest}/configs/ryzora-active.conf"
        has_mutations=true
    fi

    # Copy metadata.desktop if present
    if [ -f "${staging_dir}/metadata.desktop" ]; then
        cp --no-dereference "${staging_dir}/metadata.desktop" "${dest}/metadata.desktop"
        chmod 644 "${dest}/metadata.desktop"
        has_mutations=true
    fi

    # Copy theme.conf if present
    if [ -f "${staging_dir}/theme.conf" ]; then
        cp --no-dereference "${staging_dir}/theme.conf" "${dest}/theme.conf"
        chmod 644 "${dest}/theme.conf"
        has_mutations=true
    fi

    if [ "$has_mutations" = false ]; then
        die "Staging directory contained no allowlisted mutations"
    fi

    # Permissions: ensure backgrounds and configs are readable (mode 644 / 755), no exec
    find "${dest}/backgrounds" -type f -exec chmod a-x,a+r {} + 2>/dev/null || true
    find "${dest}/backgrounds" -type d -exec chmod 755 {} + 2>/dev/null || true
    if [ -d "${dest}/configs" ]; then
        find "${dest}/configs" -type f -exec chmod a-x,a+r {} + 2>/dev/null || true
        find "${dest}/configs" -type d -exec chmod 755 {} + 2>/dev/null || true
    fi

    # Verify Main.qml was completely untouched (immutability check)
    local main_qml_sha_after
    main_qml_sha_after=$(sha256sum "${dest}/Main.qml" | awk '{print $1}')
    if [ "$main_qml_sha_before" != "$main_qml_sha_after" ]; then
        die "Security violation: Main.qml was modified during background update!"
    fi

    log "Updated background and configuration for theme: ryzora-${slug}"
    echo "OK:background_updated:ryzora-${slug}"
}

op_remove_theme_background() {
    local slug="$1"
    local filename="$2"

    validate_slug "$slug"
    if [[ "$filename" =~ / ]] || [[ ! "$filename" =~ ^[a-zA-Z0-9_.-]{1,128}$ ]]; then
        die "Invalid background filename to remove: ${filename}"
    fi

    local target="${SDDM_THEMES_DIR}/ryzora-${slug}/backgrounds/${filename}"
    if [ -f "$target" ]; then
        rm -f "$target"
        log "Removed background file: ${target}"
    fi
    echo "OK:background_removed:${filename}"
}

op_restore_conf() {
    local staging_file="$1"
    if [[ ! "$staging_file" =~ ^/tmp/ryzora-staging-[a-zA-Z0-9_-]+(/[a-zA-Z0-9_./-]+)?$ ]]; then
        die "Invalid staging file '${staging_file}': must be under /tmp/ryzora-staging-*/"
    fi
    if [ ! -f "$staging_file" ]; then
        die "Staging file '${staging_file}' does not exist"
    fi
    mkdir -p "${SDDM_CONF_DIR}"
    rm -f "${LEGACY_CONF_FILE}"
    cp --no-dereference "$staging_file" "${RYZORA_CONF_FILE}"
    chmod 644 "${RYZORA_CONF_FILE}"
    log "Restored exact drop-in configuration from: ${staging_file}"
    echo "OK:restored_conf:${RYZORA_CONF_FILE}"
}

op_deactivate_theme() {
    rm -f "${RYZORA_CONF_FILE}" "${LEGACY_CONF_FILE}"
    log "Deactivated Ryzora SDDM theme, removed Ryzora configuration files."
    echo "OK:deactivated"
}

# Entry point
if [ $# -lt 1 ]; then
    die "Usage: ryzora-sddm-helper <operation> [args...]"
fi

OPERATION="$1"
shift

case "$OPERATION" in
    install_theme)
        [ $# -eq 2 ] || die "install_theme requires exactly 2 arguments: <staging_dir> <theme_slug>"
        op_install_theme "$1" "$2"
        ;;
    remove_theme)
        [ $# -eq 1 ] || die "remove_theme requires exactly 1 argument: <theme_slug>"
        op_remove_theme "$1"
        ;;
    activate_theme)
        [ $# -eq 1 ] || die "activate_theme requires exactly 1 argument: <theme_slug>"
        op_activate_theme "$1"
        ;;
    restore_theme)
        [ $# -eq 1 ] || die "restore_theme requires exactly 1 argument: <previous_theme_name>"
        op_restore_theme "$1"
        ;;
    set_theme_background)
        [ $# -eq 2 ] || die "set_theme_background requires exactly 2 arguments: <staging_dir> <theme_slug>"
        op_set_theme_background "$1" "$2"
        ;;
    remove_theme_background)
        [ $# -eq 2 ] || die "remove_theme_background requires exactly 2 arguments: <theme_slug> <filename>"
        op_remove_theme_background "$1" "$2"
        ;;
    restore_conf)
        [ $# -eq 1 ] || die "restore_conf requires exactly 1 argument: <staging_file>"
        op_restore_conf "$1"
        ;;
    deactivate_theme)
        op_deactivate_theme
        ;;
    *)
        die "Unknown operation '${OPERATION}'. Allowed: install_theme, remove_theme, activate_theme, restore_theme, deactivate_theme"
        ;;
esac
