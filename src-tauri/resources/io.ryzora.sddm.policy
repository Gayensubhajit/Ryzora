<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
"-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>Ryzora</vendor>
  <vendor_url>https://github.com/Gayensubhajit/Ryzora</vendor_url>

  <action id="io.ryzora.sddm.manage-theme">
    <description>Install, activate, or remove an SDDM login screen theme via Ryzora</description>
    <message>Authentication is required to manage SDDM login screen themes</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ryzora/ryzora-sddm-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>

</policyconfig>
