# Maintainer: Ryzora Contributors <contributors@ryzora.org>
pkgname=ryzora
pkgver=0.1.0
pkgrel=1
pkgdesc="Universal Linux Desktop Customization Platform"
arch=('x86_64')
url="https://github.com/Gayensubhajit/Ryzora"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-quickcontrols2' 'polkit' 'hicolor-icon-theme')
makedepends=('cargo' 'cmake' 'ninja' 'git')
optdepends=(
    'hyprland: Wayland compositor support'
    'waybar: Status bar customization'
    'hyprlock: Screen lockscreen customization'
    'fastfetch: System info fetch customization'
    'kitty: GPU-accelerated terminal rice support'
    'alacritty: Fast terminal rice support'
    'flatpak: Flatpak application repository management'
)
provides=('ryzora')
conflicts=('ryzora-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cmake -B build -S qt -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build --parallel
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build

    # Documentation & License
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
