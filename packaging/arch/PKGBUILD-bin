# Maintainer: Ryzora Contributors <contributors@ryzora.org>
pkgname=ryzora-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Universal Linux Desktop Customization Platform (Pre-compiled binary)"
arch=('x86_64')
url="https://github.com/Gayensubhajit/Ryzora"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'openssl' 'hicolor-icon-theme')
optdepends=(
    'hyprland: Wayland compositor support'
    'waybar: Status bar customization'
    'hyprlock: Screen lockscreen customization'
    'fastfetch: System info fetch customization'
    'kitty: GPU-accelerated terminal rice support'
    'alacritty: Fast terminal rice support'
)
provides=('ryzora')
conflicts=('ryzora')
source=("$url/releases/download/v$pkgver/ryzora-v$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/ryzora-v$pkgver-linux-x86_64"

    # Explicitly install precompiled binaries only
    install -Dm755 "ryzora" "$pkgdir/usr/bin/ryzora"
    if [ -f "ryzora-ci" ]; then
        install -Dm755 "ryzora-ci" "$pkgdir/usr/bin/ryzora-ci"
    fi

    # Desktop entries and MIME registration
    if [ -f "io.ryzora.Ryzora.desktop" ]; then
        install -Dm644 "io.ryzora.Ryzora.desktop" "$pkgdir/usr/share/applications/io.ryzora.Ryzora.desktop"
        ln -sf "io.ryzora.Ryzora.desktop" "$pkgdir/usr/share/applications/ryzora.desktop"
    elif [ -f "ryzora.desktop" ]; then
        install -Dm644 "ryzora.desktop" "$pkgdir/usr/share/applications/ryzora.desktop"
    fi

    # AppStream metainfo
    if [ -f "io.ryzora.Ryzora.metainfo.xml" ]; then
        install -Dm644 "io.ryzora.Ryzora.metainfo.xml" "$pkgdir/usr/share/metainfo/io.ryzora.Ryzora.metainfo.xml"
    fi

    # Icons
    if [ -d "icons/hicolor" ]; then
        cp -r icons/hicolor "$pkgdir/usr/share/icons/"
    fi

    # License and documentation
    if [ -f "LICENSE" ]; then
        install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
    if [ -f "README.md" ]; then
        install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    fi
}
