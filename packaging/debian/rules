#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	cmake -B qt/build -S qt -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build qt/build --parallel

override_dh_auto_install:
	install -Dm755 qt/build/ryzora debian/ryzora/usr/bin/ryzora
	install -Dm644 dist-assets/io.ryzora.Ryzora.desktop debian/ryzora/usr/share/applications/io.ryzora.Ryzora.desktop
	ln -sf io.ryzora.Ryzora.desktop debian/ryzora/usr/share/applications/ryzora.desktop
	install -Dm644 dist-assets/io.ryzora.Ryzora.metainfo.xml debian/ryzora/usr/share/metainfo/io.ryzora.Ryzora.metainfo.xml
	install -Dm644 dist-assets/icons/hicolor/scalable/apps/ryzora.svg debian/ryzora/usr/share/icons/hicolor/scalable/apps/ryzora.svg
	for size in 16 32 48 64 128 256 512; do \
		if [ -f dist-assets/icons/hicolor/$${size}x$${size}/apps/ryzora.png ]; then \
			install -Dm644 dist-assets/icons/hicolor/$${size}x$${size}/apps/ryzora.png \
				debian/ryzora/usr/share/icons/hicolor/$${size}x$${size}/apps/ryzora.png; \
		fi \
	done
	install -Dm755 crates/ryzora-core/resources/ryzora-sddm-helper debian/ryzora/usr/lib/ryzora/ryzora-sddm-helper
	install -Dm755 crates/ryzora-core/resources/ryzora-package-helper debian/ryzora/usr/lib/ryzora/ryzora-package-helper
	install -Dm644 crates/ryzora-core/resources/io.ryzora.sddm.policy debian/ryzora/usr/share/polkit-1/actions/io.ryzora.sddm.policy
	install -Dm644 crates/ryzora-core/resources/io.ryzora.package.policy debian/ryzora/usr/share/polkit-1/actions/io.ryzora.package.policy
	install -Dm644 crates/ryzora-core/resources/io.ryzora.sddm.rules debian/ryzora/usr/share/polkit-1/rules.d/io.ryzora.sddm.rules
	install -Dm644 crates/ryzora-core/resources/io.ryzora.package.rules debian/ryzora/usr/share/polkit-1/rules.d/io.ryzora.package.rules
